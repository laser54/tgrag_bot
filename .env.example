# Telegram Bot
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=

# Server
PORT=8080
WEBAPP_URL=http://localhost:8080/webapp/
WEBHOOK_URL=

# Pinggy tunnel (optional, for persistent URL)
# Get token at https://pinggy.io — free plan works without it
PINGGY_TOKEN=

# Qdrant Vector Database
# Leave empty for "not_configured" mode - can be set via Mini App later
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=tgrag-bot
USE_LOCAL_QDRANT=false

# OpenAI / LLM Provider
# Leave empty to disable RAG features until configured
OPENAI_API_KEY=
OPENAI_BASE_URL=
# For compatible providers (e.g., Azure, local Ollama with OpenAI API)

# Models (defaults as of Jan 2026)
EMBEDDING_MODEL=text-embedding-3-large
LLM_MODEL=gpt-5.1-mini

# Document Storage
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_MB=10
